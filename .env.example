# Copy to .env.local and fill in. Never commit real values.

# Supabase (region ca-central-1)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=

# Stripe (test keys until go-live)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_FAMILY_MONTHLY=
STRIPE_PRICE_FAMILY_YEARLY=
STRIPE_PRICE_FAMILY_PLUS_MONTHLY=
STRIPE_PRICE_FAMILY_PLUS_YEARLY=

# Cookie signing secrets (openssl rand -hex 32)
KIOSK_COOKIE_SECRET=
ADMIN_MODE_SECRET=

# Email (optional in v1)
RESEND_API_KEY=

# App
APP_URL=http://localhost:3000
LEGAL_ENTITY_NAME=
